# Gateway API key required in X-API-Key header
YUNZHUN_API_KEY=dev-key-change-me

# SQLite by default; swap for postgres:// when needed
YUNZHUN_DB_URL=sqlite:///./yunzhun.db

# Background IMAP sync
YUNZHUN_SYNC_ENABLED=true
YUNZHUN_SYNC_INTERVAL_SECONDS=120
YUNZHUN_FLAG_REFRESH_WINDOW=200

# Jev semantic judgment layer (optional)
# Default provider "vercel" routes through Vercel AI Gateway (free tier):
YUNZHUN_JEV_PROVIDER=vercel
YUNZHUN_VERCEL_GATEWAY_KEY=
# Or TypeSafe direct:
# YUNZHUN_JEV_PROVIDER=typesafe
# YUNZHUN_JEV_API_KEY=

# Fernet key for encrypting 163 auth codes at rest.
# Leave empty to auto-generate .fernet.key next to the project.
YUNZHUN_ENCRYPTION_KEY=
